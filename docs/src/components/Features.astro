---
// Feature grid for the landing page.
// Usage: <Features />
const features = [
  {
    title: 'YAML, not HCL',
    desc: 'No new language to learn. Describe your repos in plain YAML.',
    icon: '<path d="M8 4 4 12l4 8M16 4l4 8-4 8"/>',
  },
  {
    title: 'No state file',
    desc: 'GitHub is the source of truth. No drift. No state to manage.',
    icon: '<ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6M3 3l18 18"/>',
  },
  {
    title: 'Plan & Apply',
    desc: 'Preview every change before it happens. Apply with confidence.',
    icon: '<path d="M4 7h10M4 12h16M4 17h7"/>',
  },
  {
    title: 'Just gh + a token',
    desc: 'No apps. No servers. No infra. Just a gh extension.',
    icon: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m7 10 3 2-3 2M13 14h4"/>',
  },
  {
    title: 'RepositorySet',
    desc: 'Manage repos at scale. Shared defaults, per-repo overrides.',
    icon: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  },
  {
    title: 'File delivery',
    desc: 'Distribute files across repos via push or pull request.',
    icon: '<path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8z"/><path d="M14 3v5h5"/>',
  },
];
---
<div class="features not-content">
  {
    features.map((f) => (
      <div class="feature">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={f.icon} />
        <h3>{f.title}</h3>
        <p>{f.desc}</p>
      </div>
    ))
  }
</div>

<style>
  .features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--gi-line);
    border-left: 1px solid var(--gi-line);
  }

  .feature {
    padding: 1.375rem 1.5rem 1.5rem;
    border-right: 1px solid var(--gi-line);
    border-bottom: 1px solid var(--gi-line);
  }

  svg {
    display: block;
    width: 18px;
    height: 18px;
    margin-bottom: 0.75rem;
    color: var(--gi-fg2);
  }

  h3 {
    margin: 0 0 0.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--gi-fg);
  }

  p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--gi-fg2);
  }

  @media (max-width: 50rem) {
    .features {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
