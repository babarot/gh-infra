---
// Copyable install command.
// Usage: <InstallBox />
const command = 'gh extension install babarot/gh-infra';
---
<div class="install-box not-content">
  <code><span class="prompt">$</span> {command}</code>
  <button class="install-copy" type="button" aria-label="Copy install command" data-command={command}>
    <svg class="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
    <svg class="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.install-copy').forEach((btn) => {
    btn.addEventListener('click', () => {
      navigator.clipboard.writeText(btn.dataset.command ?? '').then(() => {
        btn.classList.add('copied');
        setTimeout(() => btn.classList.remove('copied'), 2000);
      });
    });
  });
</script>

<style>
  .install-box {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 100%;
    margin-top: 1.25rem;
    padding: 0.375rem 0.375rem 0.375rem 0.75rem;
    border: 1px solid var(--gi-line);
    border-radius: 8px;
    background: var(--gi-bg2);
  }

  code {
    overflow-x: auto;
    white-space: nowrap;
    font-family: var(--__sl-font-mono);
    font-size: 0.8125rem;
    color: var(--gi-fg2);
    background: none;
    padding: 0;
  }

  .prompt {
    color: var(--gi-fg3);
  }

  .install-copy {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 1.625rem;
    height: 1.625rem;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--gi-fg3);
    cursor: pointer;
  }

  .install-copy:hover {
    color: var(--gi-fg);
    background: var(--gi-accbg);
  }

  svg {
    width: 14px;
    height: 14px;
  }

  .icon-check,
  .copied .icon-copy {
    display: none;
  }

  .copied .icon-check {
    display: block;
    color: var(--gi-add);
  }
</style>
