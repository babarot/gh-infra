---
// Theme switch as three icon buttons (auto, dark, light), replacing
// Starlight's select. It stores the choice under the same localStorage key
// and in the same format as Starlight, whose ThemeProvider applies it before
// the page paints.
const options = [
  {
    value: 'auto',
    label: 'Auto',
    icon: '<circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"/>',
  },
  {
    value: 'dark',
    label: 'Dark',
    icon: '<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/>',
  },
  {
    value: 'light',
    label: 'Light',
    icon: '<circle cx="12" cy="12" r="3.5"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"/>',
  },
];
---

<gi-theme-toggle role="radiogroup" aria-label="Theme">
  {
    options.map((o) => (
      <button type="button" role="radio" aria-checked="false" aria-label={o.label} title={o.label} data-theme-value={o.value}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={o.icon} />
      </button>
    ))
  }
</gi-theme-toggle>

{/* Inlined so the current choice is marked before the page paints. */}
<script is:inline>
  (() => {
    const stored = typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
    const theme = stored === 'dark' || stored === 'light' ? stored : 'auto';
    document.querySelectorAll('gi-theme-toggle button').forEach((b) => {
      b.setAttribute('aria-checked', String(b.dataset.themeValue === theme));
      b.tabIndex = b.dataset.themeValue === theme ? 0 : -1;
    });
  })();
</script>

<script>
  type Theme = 'auto' | 'dark' | 'light';

  const storageKey = 'starlight-theme';

  const parseTheme = (theme: unknown): Theme =>
    theme === 'dark' || theme === 'light' ? theme : 'auto';

  const loadTheme = (): Theme => {
    try {
      return parseTheme(localStorage.getItem(storageKey));
    } catch {
      return 'auto';
    }
  };

  function storeTheme(theme: Theme): void {
    try {
      localStorage.setItem(storageKey, theme === 'auto' ? '' : theme);
    } catch {
      // Storage can be unavailable (private mode); the choice then lasts for the page only.
    }
  }

  const preferredScheme = (): 'dark' | 'light' =>
    matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

  function applyTheme(theme: Theme): void {
    document.documentElement.dataset.theme = theme === 'auto' ? preferredScheme() : theme;
    document.querySelectorAll<HTMLButtonElement>('gi-theme-toggle button').forEach((b) => {
      b.setAttribute('aria-checked', String(b.dataset.themeValue === theme));
      // Only the chosen option is in the tab order, as in a radio group.
      b.tabIndex = b.dataset.themeValue === theme ? 0 : -1;
    });
  }

  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (loadTheme() === 'auto') applyTheme('auto');
  });

  class GiThemeToggle extends HTMLElement {
    constructor() {
      super();
      const buttons = [...this.querySelectorAll<HTMLButtonElement>('button')];
      buttons.forEach((b, i) => {
        b.addEventListener('click', () => {
          const theme = parseTheme(b.dataset.themeValue);
          storeTheme(theme);
          applyTheme(theme);
        });
        // Arrow keys move between the options, as in a radio group.
        b.addEventListener('keydown', (e) => {
          const step = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
          if (!step) return;
          e.preventDefault();
          const next = buttons[(i + step + buttons.length) % buttons.length];
          next.focus();
          next.click();
        });
      });
      applyTheme(loadTheme());
    }
  }
  customElements.define('gi-theme-toggle', GiThemeToggle);
</script>

<style>
  gi-theme-toggle {
    /* The mobile menu footer is a flex row that would stretch it. */
    align-self: center;
    align-items: center;
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--gi-line2);
    border-radius: 999px;
  }

  button {
    display: grid;
    place-items: center;
    width: 1.625rem;
    height: 1.625rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--gi-fg3);
    cursor: pointer;
  }

  button:hover {
    color: var(--gi-fg);
  }

  button[aria-checked='true'] {
    background: var(--gi-accbg);
    color: var(--gi-fg);
  }

  button:focus-visible {
    outline: 2px solid var(--gi-fg);
    outline-offset: 1px;
  }

  svg {
    width: 15px;
    height: 15px;
  }
</style>
