---
// Theme switch as one button that flips between dark and light, replacing
// Starlight's select.
//
// With nothing stored the site follows the OS, as Starlight's "auto" does.
// A click stores the other theme, unless that theme is what the OS prefers:
// then the stored choice is cleared and the site follows the OS again. So a
// choice is stored only while it differs from the OS.
//
// The choice is stored under Starlight's localStorage key and in its format
// ('dark', 'light', or '' for auto), so Starlight's ThemeProvider applies it
// before the page paints.
---

<gi-theme-toggle>
  <button type="button" class="gi-theme-button" aria-label="Switch to light theme">
    <svg class="to-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="3.5" />
      <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" />
    </svg>
    <svg class="to-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
    </svg>
  </button>
</gi-theme-toggle>

{/* Inlined so the label matches the current theme before the page paints. */}
<script is:inline>
  document.querySelectorAll('.gi-theme-button').forEach((b) => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    b.setAttribute('aria-label', 'Switch to ' + next + ' theme');
  });
</script>

<script>
  type Scheme = 'dark' | 'light';

  const storageKey = 'starlight-theme';

  const osScheme = (): Scheme =>
    matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

  /** The stored choice, or undefined when the site follows the OS. */
  function storedScheme(): Scheme | undefined {
    try {
      const v = localStorage.getItem(storageKey);
      return v === 'dark' || v === 'light' ? v : undefined;
    } catch {
      return undefined;
    }
  }

  function store(scheme: Scheme | undefined): void {
    try {
      localStorage.setItem(storageKey, scheme ?? '');
    } catch {
      // Storage can be unavailable (private mode); the choice then lasts for the page only.
    }
  }

  function apply(scheme: Scheme): void {
    document.documentElement.dataset.theme = scheme;
    const next = scheme === 'dark' ? 'light' : 'dark';
    document.querySelectorAll('.gi-theme-button').forEach((b) => {
      b.setAttribute('aria-label', `Switch to ${next} theme`);
    });
  }

  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (!storedScheme()) apply(osScheme());
  });

  class GiThemeToggle extends HTMLElement {
    constructor() {
      super();
      this.querySelector('button')?.addEventListener('click', () => {
        const current = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
        const next: Scheme = current === 'dark' ? 'light' : 'dark';
        store(next === osScheme() ? undefined : next);
        apply(next);
      });
    }
  }
  customElements.define('gi-theme-toggle', GiThemeToggle);
</script>

<style>
  gi-theme-toggle {
    display: inline-flex;
    align-self: center;
  }

  button {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--gi-fg2);
    cursor: pointer;
  }

  button:hover {
    color: var(--gi-fg);
    background: var(--gi-accbg);
  }

  button:focus-visible {
    outline: 2px solid var(--gi-fg);
    outline-offset: 1px;
  }

  svg {
    width: 17px;
    height: 17px;
  }

  /* The icon shows the theme a click switches to. */
  :global([data-theme='dark']) .to-dark,
  :global([data-theme='light']) .to-light {
    display: none;
  }
</style>
