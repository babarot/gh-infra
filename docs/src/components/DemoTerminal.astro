---
// Panel for a demo GIF, with a light-theme variant.
// Usage: <DemoTerminal /> or <DemoTerminal darkSrc="/demo-apply.gif" />
import Window from './Window.astro';

interface Props {
  darkSrc?: string;
  lightSrc?: string;
  alt?: string;
  title?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const { darkSrc, lightSrc, alt = 'gh-infra demo', title = '~/repos' } = Astro.props;
const darkUrl = darkSrc || `${base}/demo.gif`;
const lightUrl = lightSrc || `${base}/demo-light.gif`;
const hasLight = !!lightSrc || !darkSrc;
---
<Window title={title} class="demo-terminal not-content">
  <img src={darkUrl} alt={alt} class:list={['demo-gif', { 'demo-dark': hasLight }]} loading="eager" />
  {hasLight && <img src={lightUrl} alt={alt} class="demo-gif demo-light" loading="eager" />}
</Window>

<style>
  :global(.demo-terminal) {
    margin-block: 2rem;
  }

  .demo-gif {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
  }

  .demo-light {
    display: none;
  }

  :global([data-theme='light']) .demo-dark {
    display: none;
  }

  :global([data-theme='light']) .demo-light {
    display: block;
  }
</style>
