---
// 2×2 grid of CLI output panels showing key capabilities.
// Each panel emulates real gh-infra CLI output.
import Window from './Window.astro';

const repositorySet = `  <span class="t-chg">~</span> <span class="t-w">babarot/my-cli</span>  <span class="t-dim">1 to update</span>
      <span class="t-chg">~</span> required_reviews  1 <span class="t-dim">→</span> <span class="t-w">2</span>

  <span class="t-chg">~</span> <span class="t-w">babarot/my-api</span>  <span class="t-dim">1 to update</span>
      <span class="t-chg">~</span> required_reviews  1 <span class="t-dim">→</span> <span class="t-w">2</span>

  <span class="t-chg">~</span> <span class="t-w">babarot/my-web</span>  <span class="t-dim">1 to update</span>
      <span class="t-chg">~</span> required_reviews  1 <span class="t-dim">→</span> <span class="t-w">2</span>

Plan: <span class="t-chg">~</span> <span class="t-w">3</span> to update <span class="t-dim">in 3 repositories</span>`;

const parallelApply = `<span class="t-add">✓</span> Applied <span class="t-w">5</span> changes in 2.1s

  <span class="t-add">✓</span> <span class="t-w">babarot/my-cli</span>   <span class="t-dim">1.8s  2 applied</span>
  <span class="t-add">✓</span> <span class="t-w">babarot/my-api</span>   <span class="t-dim">1.2s  1 applied</span>
  <span class="t-add">✓</span> <span class="t-w">babarot/my-web</span>   <span class="t-dim">2.1s  2 applied</span>

Apply complete! <span class="t-w">5</span> changes applied.`;

const fileDelivery = `  <span class="t-chg">~</span> <span class="t-w">babarot/my-project</span>
      <span class="t-chg">~</span> FileSet: 3 files, via <span class="t-w">pull_request</span>
          <span class="t-chg">~</span> .github/workflows/ci.yml  <span class="t-add">+18</span> <span class="t-del">-5</span>
          <span class="t-add">+</span> .github/dependabot.yml    <span class="t-add">+12</span>
          <span class="t-chg">~</span> .github/CODEOWNERS        <span class="t-add">+2</span> <span class="t-del">-1</span>

<span class="t-add">✓</span> Applied <span class="t-w">3</span> changes in 1.4s

  <span class="t-add">✓</span> <span class="t-w">babarot/my-project</span>  <span class="t-dim">1.4s  3 applied · opened pull request #42</span>`;
---
<div class="cap-grid not-content">
  <div class="cap">
    <Window title="gh infra plan ./repos/" html={repositorySet} />
    <h3>RepositorySet</h3>
    <p>One line in defaults. Three repos updated.</p>
  </div>

  <div class="cap">
    <Window title="gh infra apply ./repos/" html={parallelApply} />
    <h3>Parallel apply</h3>
    <p>Repos apply in parallel. Changes are atomic per repo.</p>
  </div>

  <div class="cap">
    <Window title="gh infra apply ./files/" html={fileDelivery} />
    <h3>File delivery</h3>
    <p>Distribute files across repos. Push or pull request.</p>
  </div>

  <div class="cap">
    <Window title="gh infra apply ./files/  (d: diff viewer)">
      <div class="diff-viewer">
        <div class="diff-main">
          <pre class="gi-win-body"><span class="t-w">app-api</span>
 <span class="t-chg">~</span> CODEOWNERS
 <span class="t-chg">~</span> ci.yml
 <span class="t-add">+</span> dependabot.yml

<span class="t-w">app-web</span>
 <span class="t-chg">~</span> CODEOWNERS
 <span class="t-chg">~</span> ci.yml
 <span class="t-dim">⚠ dependabot.yml</span></pre>
          <pre class="gi-win-body"><span class="t-del">- * @old-owner</span>
<span class="t-add">+ * @babarot @team</span>

<span class="t-dim">@@ -1,5 +1,8 @@</span>
 name: CI
<span class="t-del">- on: [push]</span>
<span class="t-add">+ on: [push, pull_req..</span></pre>
        </div>
        <pre class="gi-win-body diff-footer"><span class="t-dim">j/k: move  d/u: scroll  tab: skip  esc: done</span></pre>
      </div>
    </Window>
    <h3>Diff viewer</h3>
    <p>Browse every file diff. Skip what you don't want.</p>
  </div>
</div>

<style>
  .cap-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1rem;
  }

  /* Panels stretch so the captions of a row line up. */
  .cap {
    display: flex;
    flex-direction: column;
  }

  .cap > :global(.gi-win) {
    flex: 1;
  }

  .cap :global(.gi-win-body) {
    font-size: 0.75rem;
  }

  h3 {
    margin: 0.75rem 0 0.125rem;
    font-size: 0.90625rem;
    font-weight: 600;
    color: var(--gi-fg);
  }

  p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--gi-fg2);
  }

  .diff-main {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
  }

  .diff-main > pre + pre {
    border-left: 1px solid var(--gi-line);
  }

  .diff-footer {
    border-top: 1px solid var(--gi-line);
    padding-block: 0.5rem;
  }

  @media (max-width: 50rem) {
    .cap-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
