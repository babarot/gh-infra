---
// Two panels side by side, for example a command and the file it writes.
// Usage: <CodeShowcase leftTitle="file.yaml" rightTitle="output" leftHtml="..." rightHtml="..." />
import Window from './Window.astro';

interface Props {
  leftTitle: string;
  rightTitle: string;
  leftHtml: string;
  rightHtml: string;
}

const { leftTitle, rightTitle, leftHtml, rightHtml } = Astro.props;
---
<div class="showcase not-content">
  <Window title={leftTitle} html={leftHtml} />
  <Window title={rightTitle} html={rightHtml} />
</div>

<style>
  .showcase {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
  }

  @media (max-width: 50rem) {
    .showcase {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
