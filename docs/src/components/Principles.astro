---
// The three design principles, short, with a link to the full page.
// Keep in sync with introduction/principles.md.
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---
<div class="principles not-content">
  <div>
    <h3><code>apply</code> does what <code>plan</code> shows</h3>
    <p>Every change apply makes is in the plan, and apply makes no other change.</p>
  </div>
  <div>
    <h3>What you leave out is left alone</h3>
    <p>A field that is not in the manifest is not compared and not sent.</p>
  </div>
  <div>
    <h3>One apply converges</h3>
    <p>After apply, the next plan shows no changes.</p>
  </div>
</div>
<a class="more not-content" href={`${base}/introduction/principles/`}>Read the design principles</a>

<style>
  .principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--gi-line);
  }

  .principles > div {
    padding: 1.5rem 1.75rem 0 0;
  }

  .principles > div + div {
    padding-left: 1.75rem;
    border-left: 1px solid var(--gi-line);
  }

  h3 {
    margin: 0 0 0.375rem;
    font-size: 0.96875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--gi-fg);
  }

  code {
    font-family: var(--__sl-font-mono);
    font-size: 0.92em;
  }

  p {
    margin: 0;
    font-size: 0.90625rem;
    color: var(--gi-fg2);
  }

  .more {
    display: inline-block;
    margin-top: 1.75rem;
    font-size: 0.875rem;
    color: var(--gi-fg);
    text-decoration: underline;
    text-decoration-color: var(--gi-fg3);
    text-underline-offset: 3px;
  }

  .more:hover {
    text-decoration-color: var(--gi-fg);
  }

  @media (max-width: 50rem) {
    .principles {
      grid-template-columns: minmax(0, 1fr);
    }

    .principles > div,
    .principles > div + div {
      padding: 1.25rem 0;
      border-left: 0;
      border-bottom: 1px solid var(--gi-line);
    }
  }
</style>
